		{
			"name": "2. JWT Blacklist Flow (Redis & Logout Tức Thì)",
			"item": [
				{
					"name": "2.1 Call Protected API trước khi Logout -> 200 OK",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{adminAccessToken}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "http://localhost:8085/api/test/user",
							"protocol": "http",
							"host": [
								"localhost"
							],
							"port": "8085",
							"path": [
								"api",
								"test",
								"user"
							]
						},
						"description": "Gọi Protected API với Access Token hợp lệ trước khi Logout."
					},
					"response": []
				},
				{
					"name": "2.2 Logout (Đưa Access Token vào Redis Blacklist)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200 OK\", function () {",
									"    pm.response.to.have.status(200);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{adminAccessToken}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [],
						"url": {
							"raw": "http://localhost:8085/api/auth/logout",
							"protocol": "http",
							"host": [
								"localhost"
							],
							"port": "8085",
							"path": [
								"api",
								"auth",
								"logout"
							]
						},
						"description": "Gọi API Logout kèm Access Token. Hệ thống giải mã jti và exp, lưu blacklist:jti vào Redis với TTL."
					},
					"response": []
				},
				{
					"name": "2.3 Call Protected API sau khi Logout -> 401 Unauthorized (Bị chặn bởi Blacklist)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 401 Unauthorized (Bị chặn bởi Redis Blacklist)\", function () {",
									"    pm.response.to.have.status(401);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{adminAccessToken}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "http://localhost:8085/api/test/user",
							"protocol": "http",
							"host": [
								"localhost"
							],
							"port": "8085",
							"path": [
								"api",
								"test",
								"user"
							]
						},
						"description": "Gọi lại Protected API với Access Token vừa logout. Kết quả mong đợi: 401 Unauthorized."
					},
					"response": []
				}
			]
		},
		{
			"name": "3. Token Rotation Flow (3 Bước Kiểm Thử)",
			"item": [
				{
					"name": "Bước 1: Login lấy Token A và R1",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"var jsonData = pm.response.json();",
									"pm.environment.set(\"tokenA\", jsonData.accessToken);",
									"pm.environment.set(\"tokenR1\", jsonData.refreshToken);",
									"console.log(\"Saved tokenA and tokenR1!\");"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"user\",\n  \"password\": \"password123\"\n}"
						},
						"url": {
							"raw": "http://localhost:8085/api/auth/login",
							"protocol": "http",
							"host": [
								"localhost"
							],
							"port": "8085",
							"path": [
								"api",
								"auth",
								"login"
							]
						}
					},
					"response": []
				},
				{
					"name": "Bước 2: Gửi R1 vào /refresh -> Nhận Token B và R2",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200 OK\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"var jsonData = pm.response.json();",
									"pm.environment.set(\"tokenB\", jsonData.accessToken);",
									"pm.environment.set(\"tokenR2\", jsonData.refreshToken);",
									"pm.test(\"R2 khác R1 (Rotation thành công)\", function () {",
									"    pm.expect(jsonData.refreshToken).to.not.equal(pm.environment.get(\"tokenR1\"));",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"refreshToken\": \"{{tokenR1}}\"\n}"
						},
						"url": {
							"raw": "http://localhost:8085/api/auth/refresh",
							"protocol": "http",
							"host": [
								"localhost"
							],
							"port": "8085",
							"path": [
								"api",
								"auth",
								"refresh"
							]
						}
					},
					"response": []
				},
				{
					"name": "Bước 3: Gửi lại R1 vào /refresh -> Nhận 403 Forbidden",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 403 Forbidden\", function () {",
									"    pm.response.to.have.status(403);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"refreshToken\": \"{{tokenR1}}\"\n}"
						},
						"url": {
							"raw": "http://localhost:8085/api/auth/refresh",
							"protocol": "http",
							"host": [
								"localhost"
							],
							"port": "8085",
							"path": [
								"api",
								"auth",
								"refresh"
							]
						}
					},
					"response": []
				}
			]
		},

				{
					"name": "5.4 Gọi Product-Service qua Gateway (Sau Logout) -> 401 (Chặn tại Gateway)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 401 Unauthorized (Bị Gateway chặn ngay cửa ngõ)\", function () {",
									"    pm.response.to.have.status(401);",
									"});",
									"var jsonData = pm.response.json();",
									"pm.test(\"Message xác nhận bị chặn tại Gateway\", function () {",
									"    pm.expect(jsonData.message).to.include(\"Blacklisted tại Gateway\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [

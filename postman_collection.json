							"path": [
								"api",
								"products"
							]
						},
						"description": "Truy cập Product-Service qua Gateway khi token hợp lệ và chưa logout. Gateway cho phép đi tiếp và trả về 200 OK."
					},
					"response": []
				},
				{
					"name": "5.3 Logout qua Gateway -> 200 OK",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200 OK\", function () {",
									"    pm.response.to.have.status(200);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{gwAccessToken}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [],
						"url": {
							"raw": "http://localhost:8088/api/auth/logout",
							"protocol": "http",
							"host": [
								"localhost"
							],
							"port": "8088",
							"path": [
								"api",
								"auth",

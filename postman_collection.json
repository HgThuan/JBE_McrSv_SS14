		{
			"name": "5. API Gateway (Port 8088 - Centralized Security)",
			"item": [
				{
					"name": "5.1 Login qua Gateway (Port 8088)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200 OK\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"var jsonData = pm.response.json();",
									"if (jsonData.accessToken) {",
									"    pm.environment.set(\"gwAccessToken\", jsonData.accessToken);",
									"    pm.environment.set(\"gwRefreshToken\", jsonData.refreshToken);",
									"    console.log(\"Saved gwAccessToken from Gateway!\");",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"admin\",\n  \"password\": \"password123\"\n}"
						},
						"url": {
							"raw": "http://localhost:8088/api/auth/login",
							"protocol": "http",
							"host": [
								"localhost"
							],
							"port": "8088",
							"path": [
								"api",
								"auth",
								"login"
							]
						},
						"description": "Gọi login qua Spring Cloud Gateway (Port 8088) chuyển tiếp đến Identity-Service (Port 8085)."
					},
					"response": []
				},
				{
					"name": "5.2 Gọi Product-Service qua Gateway (Trước Logout) -> 200 OK",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200 OK\", function () {",
									"    pm.response.to.have.status(200);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {

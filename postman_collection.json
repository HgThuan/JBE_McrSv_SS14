{
	"info": {
		"_postman_id": "c71a3841-3850-48cf-94f4-7e826e7a6850",
		"name": "Session 14 - Microservices Security (Complete Suite)",
		"description": "Postman Collection hoàn chỉnh cho toàn bộ Session 14:\n1. Identity-Service (Port 8085): Access Token + Refresh Token (PostgreSQL).\n2. Token Rotation Flow (3 Bước): Cấp mới và hủy token cũ.\n3. JWT Blacklist Flow (Redis & Logout): Lưu jti vào Redis với TTL và chặn token đã logout.\n4. Product-Service Resource Server (Port 8086): Phân quyền Method Level Security.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Authentication & Tokens (Identity-Service)",
			"item": [
				{
					"name": "1.1 Login as ADMIN (Lấy Admin Access Token có JTI)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"var jsonData = pm.response.json();",
									"if (jsonData.accessToken) {",
									"    pm.environment.set(\"adminAccessToken\", jsonData.accessToken);",
									"    pm.environment.set(\"adminRefreshToken\", jsonData.refreshToken);",
									"    console.log(\"Saved adminAccessToken!\");",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"admin\",\n  \"password\": \"password123\"\n}"
						},
						"url": {
							"raw": "http://localhost:8085/api/auth/login",
							"protocol": "http",
							"host": [
								"localhost"
							],
							"port": "8085",
							"path": [
								"api",
								"auth",
								"login"
							]
						}
					},
					"response": []
				},
				{
